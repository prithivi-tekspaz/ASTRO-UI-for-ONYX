---
// src/pages/search.astro
// Dedicated Document Retrieval & Passage Inspection Interface
// References: Agentic RAG System Complete Design Document v11 (§12.4, §12.6, §15.1)
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Search — Rust Knowledge Agent v11" activeRoute="search" pageTitle="Search">
  <div class="page-workspace">
    <div class="page-header">
      <div class="page-title-group">
        <h1 class="page-title">Document Retrieval</h1>
        <p class="page-subtitle">Candidate passage retrieval across indexed internal documents (POST /v1/search)</p>
      </div>

      <div style="display:flex; align-items:center; gap:8px;">
        <span class="status-badge info" style="font-size:11px;">Hybrid (Vector + FTS)</span>
      </div>
    </div>

    <div class="page-body-scroll">
      <div class="page-content-container">
        <!-- Search Input Bar -->
        <form id="searchForm" class="search-input-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-muted); flex-shrink:0;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="searchQuery" 
            placeholder="Search passages, technical policies, or documentation clauses..." 
            autocomplete="off"
            required
          />
          <button type="submit" class="btn-primary" id="searchSubmitBtn">Search</button>
        </form>

        <!-- Live Server Status Indicator -->
        <div id="searchConnectionNote" style="display:none; font-size:12px; padding:8px 12px; border-radius:var(--radius-sm); background:rgba(239, 68, 68, 0.08); border:1px solid rgba(239, 68, 68, 0.2); color:var(--status-danger);">
        </div>

        <!-- Dynamic Results Container -->
        <div id="searchResultsSection" style="display: flex; flex-direction: column; gap: var(--space-4);">
          <div id="resultsCount" style="font-size: var(--text-xs); color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;"></div>
          <div id="resultsList" style="display: flex; flex-direction: column; gap: var(--space-3);"></div>
        </div>

        <!-- Initial Search Empty State -->
        <div id="searchInitialState" style="text-align: center; padding: 48px 16px; color: var(--text-muted);">
          <div style="font-size: 32px; margin-bottom: 8px;">🔍</div>
          <h2 style="font-size: 16px; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px;">Enter a query to retrieve candidate passages</h2>
          <p style="font-size: 13px;">Passages retrieved here represent un-evaluated candidates before Grounding Gate screening.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { searchKnowledge } from '../lib/rag/api';
    import { escapeHtml } from '../lib/onyx/markdown';

    const form = document.getElementById('searchForm') as HTMLFormElement;
    const input = document.getElementById('searchQuery') as HTMLInputElement;
    const resultsCount = document.getElementById('resultsCount')!;
    const resultsList = document.getElementById('resultsList')!;
    const initialState = document.getElementById('searchInitialState')!;
    const connectionNote = document.getElementById('searchConnectionNote')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;

      connectionNote.style.display = 'none';
      initialState.style.display = 'none';
      resultsList.innerHTML = '<div style="color:var(--text-muted);font-size:13px;padding:12px 0;">Retrieving candidate passages from Rust backend (/v1/search)...</div>';

      try {
        const results = await searchKnowledge(query);
        resultsCount.innerText = `${results.length} candidate passage(s) retrieved via Hybrid search`;
        resultsList.innerHTML = '';

        if (results.length === 0) {
          resultsList.innerHTML = '<div style="color:var(--text-muted);font-size:13px;padding:12px 0;">No matching candidate passages found in permitted documents.</div>';
          return;
        }

        results.forEach((res, idx) => {
          const card = document.createElement('div');
          card.className = 'onyx-card';
          card.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <div>
                <div style="font-weight:600; font-size:14px; color:var(--text-main); display:flex; align-items:center; gap:6px;">
                  <span>[${idx + 1}]</span>
                  <span>📄 ${escapeHtml(res.title || 'Document Passage')}</span>
                  ${res.sourceLocation ? `<span style="font-size:11px; color:var(--text-muted); font-weight:normal;">[${escapeHtml(res.sourceLocation)}]</span>` : ''}
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:6px;">
                <span class="status-badge info" style="font-size:10px;">Score: ${(res.score || 0.85).toFixed(3)}</span>
                <button class="btn-secondary" style="font-size:11px; padding:3px 8px;" onclick="window.investigateInChat('${escapeHtml(query)}')">Investigate in Chat</button>
              </div>
            </div>
            <div style="font-size:13px; line-height:1.6; color:var(--text-secondary); background:var(--bg-app); padding:10px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-subtle);">
              ${escapeHtml(res.snippet)}
            </div>
          `;
          resultsList.appendChild(card);
        });
      } catch (err: any) {
        resultsList.innerHTML = '';
        connectionNote.style.display = 'block';
        connectionNote.innerText = `Search request failed: ${err.message}. Ensure Axum backend is running on port 8080.`;
      }
    });

    (window as any).investigateInChat = function(queryText: string) {
      sessionStorage.setItem('pending_chat_prompt', queryText);
      window.location.href = '/';
    };
  </script>
</AppLayout>
