---
// src/pages/index.astro
// Agentic RAG Workspace — Main Chat & Transparent Execution View
// References: Agentic RAG System Complete Design Document v11 (§0, §3.4, §13, §14, §15)
import AppLayout from '../layouts/AppLayout.astro';
import ChatEmptyState from '../components/chat/ChatEmptyState.astro';
import ChatComposer from '../components/chat/ChatComposer.astro';
---

<AppLayout title="Chat — Rust Knowledge Agent v11" activeRoute="chat">
  <div class="chat-workspace">
    <!-- Messages Scrollable Viewport -->
    <div class="chat-scroll-area" id="chatScrollArea">
      <div class="chat-content-column" id="chatMessageColumn">
        <!-- Welcoming Empty State -->
        <ChatEmptyState />
      </div>
    </div>

    <!-- Pinned Bottom Message Composer -->
    <ChatComposer />
  </div>

  <script>
    import { renderMarkdown, escapeHtml } from '../lib/onyx/markdown';
    import { streamAgentRag } from '../lib/rag/streaming';
    import { getConversation, deleteConversation, uploadDocuments, resolveCitation } from '../lib/rag/api';
    import type { 
      ClaimUnit, 
      Citation, 
      DonePayload, 
      VerificationPayload, 
      ClarificationPayload,
      RunOutcome,
      CoverageStatus
    } from '../lib/rag/types';

    // Application Chat State
    let activeSessionId = localStorage.getItem('onyx_session_id') || ('sess_' + Math.random().toString(36).substring(2, 10));
    localStorage.setItem('onyx_session_id', activeSessionId);

    let isGenerating = false;
    let abortController: AbortController | null = null;
    let attachedFiles: File[] = [];

    // DOM Elements
    const chatScrollArea = document.getElementById('chatScrollArea')!;
    const messageColumn = document.getElementById('chatMessageColumn')!;
    const emptyState = document.getElementById('chatEmptyState')!;
    const queryInput = document.getElementById('composerQueryInput') as HTMLTextAreaElement;
    const sendBtn = document.getElementById('composerSendBtn') as HTMLButtonElement;
    const stopBtn = document.getElementById('composerStopBtn') as HTMLButtonElement;
    const attachBtn = document.getElementById('composerAttachBtn') as HTMLButtonElement;
    const fileInput = document.getElementById('composerFileInput') as HTMLInputElement;
    const attachmentsArea = document.getElementById('composerAttachmentsArea')!;
    const uploadFeedback = document.getElementById('composerUploadFeedback')!;
    const headerDeleteBtn = document.getElementById('headerDeleteChatBtn');
    const headerNewBtn = document.getElementById('headerNewChatBtn');
    const sidebarNewBtn = document.getElementById('sidebarNewChatBtn');

    // 1. Textarea Auto-Resize & Button State
    function updateSendState() {
      const hasText = queryInput.value.trim().length > 0 || attachedFiles.length > 0;
      sendBtn.disabled = !hasText || isGenerating;

      if (isGenerating) {
        sendBtn.style.display = 'none';
        stopBtn.style.display = 'inline-flex';
      } else {
        sendBtn.style.display = 'inline-flex';
        stopBtn.style.display = 'none';
      }
    }

    function resizeInput() {
      queryInput.style.height = 'auto';
      queryInput.style.height = Math.min(queryInput.scrollHeight, 180) + 'px';
    }

    queryInput.addEventListener('input', () => {
      resizeInput();
      updateSendState();
    });

    queryInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!sendBtn.disabled && !isGenerating) {
          handleSendMessage();
        }
      }
    });

    // 2. Global Prompt Ingestion
    (window as any).populateComposerPrompt = function(promptText: string) {
      queryInput.value = promptText;
      resizeInput();
      updateSendState();
      queryInput.focus();
    };

    // 3. Attachments & Ingestion (Supported: PDF, DOCX, PPTX in Release 1)
    attachBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.files || target.files.length === 0) return;

      const newFiles = Array.from(target.files);
      const supportedExtensions = ['pdf', 'docx', 'pptx'];
      const rejectedFiles = newFiles.filter(f => !supportedExtensions.includes(f.name.split('.').pop()?.toLowerCase() || ''));

      if (rejectedFiles.length > 0) {
        uploadFeedback.style.display = 'block';
        uploadFeedback.innerHTML = `<span style="color:var(--status-danger)">Unsupported format: ${escapeHtml(rejectedFiles.map(f => f.name).join(', '))}. Release 1 supports text-extractable PDF, .docx, and .pptx only.</span>`;
        setTimeout(() => { uploadFeedback.style.display = 'none'; }, 5000);
        fileInput.value = '';
        return;
      }

      newFiles.forEach(f => attachedFiles.push(f));
      renderAttachmentChips();
      updateSendState();

      // Upload files to backend immediately
      uploadFeedback.style.display = 'block';
      uploadFeedback.innerText = `Ingesting ${newFiles.length} file(s) into vector vault...`;
      try {
        await uploadDocuments(newFiles);
        uploadFeedback.innerText = `Uploaded ${newFiles.length} file(s). Now indexed for document retrieval.`;
        setTimeout(() => { uploadFeedback.style.display = 'none'; }, 3500);
      } catch (err: any) {
        uploadFeedback.innerHTML = `<span style="color:var(--status-danger)">Ingestion error: ${escapeHtml(err.message)}</span>`;
        setTimeout(() => { uploadFeedback.style.display = 'none'; }, 5000);
      }

      fileInput.value = '';
    });

    function renderAttachmentChips() {
      if (attachedFiles.length === 0) {
        attachmentsArea.style.display = 'none';
        attachmentsArea.innerHTML = '';
        return;
      }
      attachmentsArea.style.display = 'flex';
      attachmentsArea.innerHTML = attachedFiles.map((file, idx) => `
        <span class="attachment-chip">
          <span>📄</span>
          <span>${escapeHtml(file.name)}</span>
          <button type="button" class="btn-remove-attachment" onclick="window.removeAttachment(${idx})">✕</button>
        </span>
      `).join('');
    }

    (window as any).removeAttachment = function(idx: number) {
      attachedFiles.splice(idx, 1);
      renderAttachmentChips();
      updateSendState();
    };

    // 4. Render Message Row with Units & Citations
    function appendMessageRow(
      role: 'user' | 'assistant', 
      initialHtml: string, 
      citations: Citation[] = [], 
      outcome?: RunOutcome, 
      coverage?: CoverageStatus,
      lowConfidence?: boolean
    ) {
      emptyState.style.display = 'none';

      const row = document.createElement('div');
      row.className = `message-row ${role}`;

      const header = document.createElement('div');
      header.className = 'message-header';
      header.innerHTML = role === 'user' 
        ? '<span>You</span>' 
        : '<span style="color:var(--brand-cyan);display:flex;align-items:center;gap:4px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>Agentic RAG Orchestrator (v11)</span>';
      row.appendChild(header);

      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';
      bubble.innerHTML = initialHtml;
      row.appendChild(bubble);

      if (role === 'assistant') {
        if (outcome && outcome !== 'answer') {
          row.appendChild(createOutcomeBanner(outcome));
        } else if (coverage === 'partial' || lowConfidence) {
          row.appendChild(createCoverageBanner(coverage, lowConfidence));
        }

        if (citations && citations.length > 0) {
          const citationPanel = createCitationPanel(citations);
          row.appendChild(citationPanel);
        }

        const actions = document.createElement('div');
        actions.className = 'message-actions';
        actions.innerHTML = `
          <button class="btn-msg-action" onclick="navigator.clipboard.writeText(this.closest('.message-row').querySelector('.message-bubble').innerText); this.innerText = 'Copied!'; setTimeout(() => this.innerText = 'Copy', 2000);">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        `;
        row.appendChild(actions);
      }

      messageColumn.appendChild(row);
      chatScrollArea.scrollTop = chatScrollArea.scrollHeight;
      return bubble;
    }

    function createOutcomeBanner(outcome: RunOutcome, reason?: string) {
      const banner = document.createElement('div');
      banner.className = 'evidence-sufficiency-banner partial';

      if (outcome === 'refer_to_owner') {
        banner.style.borderColor = 'rgba(234, 179, 8, 0.4)';
        banner.style.background = 'rgba(234, 179, 8, 0.08)';
        banner.innerHTML = `
          <span>👤</span>
          <span><strong>Referred to Business Owner:</strong> This query is outside the approved document scope, or requires live systems data. In accordance with Release 1 policy (§0.1 D3), it has been referred to the Business Owner.</span>
        `;
      } else if (outcome === 'fail_gracefully') {
        banner.style.borderColor = 'rgba(239, 68, 68, 0.4)';
        banner.style.background = 'rgba(239, 68, 68, 0.08)';
        banner.innerHTML = `
          <span>⚠️</span>
          <span><strong>Insufficient Verified Evidence:</strong> The knowledge base does not contain sufficient verified passages to support an answer to this query. Verified partial findings are preserved above.</span>
        `;
      } else if (outcome === 'upstream_failure') {
        banner.style.borderColor = 'rgba(239, 68, 68, 0.4)';
        banner.style.background = 'rgba(239, 68, 68, 0.08)';
        banner.innerHTML = `
          <span>⚡</span>
          <span><strong>Upstream Provider Error:</strong> The model host encountered a temporary error. Partial verified units have been preserved. You may retry this request.</span>
        `;
      }
      return banner;
    }

    function createCoverageBanner(coverage?: CoverageStatus, lowConfidence?: boolean) {
      const banner = document.createElement('div');
      banner.className = 'evidence-sufficiency-banner partial';
      if (lowConfidence) {
        banner.innerHTML = `
          <span>⚠️</span>
          <span><strong>Low Confidence Warning:</strong> Over 40% of candidate claim units were withheld by the Grounding Gate because they could not be corroborated against cited evidence.</span>
        `;
      } else if (coverage === 'partial') {
        banner.innerHTML = `
          <span>ℹ️</span>
          <span><strong>Partial Coverage:</strong> This answer covers only verified requirements from the approved documents. Some conditions or comparisons could not be corroborated.</span>
        `;
      } else {
        banner.className = 'evidence-sufficiency-banner sufficient';
        banner.innerHTML = `
          <span>✓</span>
          <span><strong>Checked Against Sources:</strong> All claim units corroborated by Grounding Gate (C1–C5) against approved internal documents.</span>
        `;
      }
      return banner;
    }

    function createCitationPanel(citations: Citation[]) {
      const panel = document.createElement('div');
      panel.className = 'citation-panel';
      panel.innerHTML = `
        <div class="citation-header" onclick="const list = this.nextElementSibling; const chev = this.querySelector('.chevron'); const isHidden = list.style.display === 'none'; list.style.display = isHidden ? 'flex' : 'none'; chev.innerText = isHidden ? '▲' : '▼';">
          <div style="display:flex;align-items:center;gap:6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <span>Verified Sources & Citations (${citations.length})</span>
          </div>
          <span class="chevron" style="font-size: 10px; color:var(--text-muted);">▼</span>
        </div>
        <div class="citation-list" style="display: none;">
          ${citations.map((s, idx) => `
            <div class="citation-card" data-cite-id="${s.id}">
              <div class="citation-meta">
                <div class="citation-meta-left">
                  <span>[${idx + 1}]</span>
                  <span>📄 ${escapeHtml(s.filename || s.title || 'Internal Document')}</span>
                  ${s.sourceLocation ? `<span style="color:var(--text-muted);font-weight:normal;">[${escapeHtml(s.sourceLocation)}]</span>` : ''}
                </div>
                <span class="status-badge success" style="font-size:9px;padding:1px 5px;">Checked</span>
              </div>
              <div class="citation-snippet">${escapeHtml(s.snippet || s.content ? (s.snippet || s.content || '').substring(0, 320) + ((s.snippet || s.content || '').length > 320 ? '...' : '') : 'Passage text verified from immutable document version.')}</div>
            </div>
          `).join('')}
        </div>
      `;
      return panel;
    }

    // 5. Execution Timeline Creation & Updates
    function createLiveExecutionTimeline(containerRow: HTMLElement) {
      const timelineBox = document.createElement('div');
      timelineBox.className = 'agent-timeline-container';
      timelineBox.innerHTML = `
        <div class="agent-timeline-header open" onclick="const b = this.nextElementSibling; const chev = this.querySelector('.chevron'); const isHidden = b.style.display === 'none'; b.style.display = isHidden ? 'flex' : 'none'; chev.innerText = isHidden ? '▲' : '▼';">
          <div class="timeline-header-left">
            <div class="timeline-pulse-dot"></div>
            <span class="timeline-header-title">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
              <span>Agent Execution Trace (v11)</span>
            </span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="timeline-header-meta" style="font-size:11px;">Routing...</span>
            <span class="chevron" style="font-size:10px; color:var(--text-muted);">▲</span>
          </div>
        </div>
        <div class="agent-timeline-body">
        </div>
      `;
      containerRow.appendChild(timelineBox);
      return timelineBox;
    }

    function addTimelineStage(timelineEl: HTMLElement, step: string, detail?: string, status: 'in_progress' | 'completed' | 'failed' | 'retrying' = 'completed') {
      const body = timelineEl.querySelector('.agent-timeline-body');
      if (!body) return;

      const stageItem = document.createElement('div');
      stageItem.className = 'timeline-stage-item';
      stageItem.innerHTML = `
        <div class="stage-bullet ${status}">✓</div>
        <div class="stage-content">
          <div class="stage-label-row">
            <span class="stage-title">${escapeHtml(step)}</span>
            <span class="stage-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span>
          </div>
          ${detail ? `<div class="stage-detail">${escapeHtml(detail)}</div>` : ''}
        </div>
      `;
      body.appendChild(stageItem);

      const meta = timelineEl.querySelector('.timeline-header-meta');
      if (meta) {
        meta.textContent = `${step}...`;
      }
      chatScrollArea.scrollTop = chatScrollArea.scrollHeight;
    }

    // Helper: Build markdown from claim units with structured citation badges (§13.0)
    function renderClaimUnitsMarkdown(units: ClaimUnit[]): string {
      return units.map(u => {
        const citeBadges = u.cites && u.cites.length > 0 
          ? ` ` + u.cites.map(c => `**[${c}]**`).join(' ') 
          : '';
        if (u.role === 'caveat') {
          return `> ⚠️ **Note:** ${u.text}${citeBadges}\n\n`;
        }
        return `${u.text}${citeBadges}\n\n`;
      }).join('');
    }

    // 6. Primary Chat Completion Routine
    async function handleSendMessage() {
      if (isGenerating) return;
      const query = queryInput.value.trim();
      if (!query && attachedFiles.length === 0) return;

      isGenerating = true;
      updateSendState();

      const userText = query;
      queryInput.value = '';
      resizeInput();

      // Render user query
      appendMessageRow('user', escapeHtml(userText));

      // Create assistant container row
      const assistantRow = document.createElement('div');
      assistantRow.className = 'message-row assistant';
      
      const header = document.createElement('div');
      header.className = 'message-header';
      header.innerHTML = '<span style="color:var(--brand-cyan);display:flex;align-items:center;gap:4px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>Agentic RAG Orchestrator (v11)</span>';
      assistantRow.appendChild(header);

      // Create live timeline container
      const timelineEl = createLiveExecutionTimeline(assistantRow);

      const agentBubble = document.createElement('div');
      agentBubble.className = 'message-bubble';
      agentBubble.innerHTML = '<span style="color:var(--text-muted);font-size:13px;">Evaluating document question...</span>';
      assistantRow.appendChild(agentBubble);

      messageColumn.appendChild(assistantRow);
      chatScrollArea.scrollTop = chatScrollArea.scrollHeight;

      abortController = new AbortController();
      let gatheredCitations: Citation[] = [];
      let gatheredUnits: ClaimUnit[] = [];
      let reportedDone: DonePayload | null = null;
      let reportedVerification: VerificationPayload | null = null;
      let hasReceivedTimelineEvents = false;

      try {
        await streamAgentRag({
          query: userText,
          conversationId: activeSessionId,
          signal: abortController.signal,
          onStatus: (step, detail) => {
            hasReceivedTimelineEvents = true;
            addTimelineStage(timelineEl, step, detail, 'in_progress');
          },
          onClaimUnit: (unit) => {
            gatheredUnits.push(unit);
            agentBubble.innerHTML = renderMarkdown(renderClaimUnitsMarkdown(gatheredUnits));
            chatScrollArea.scrollTop = chatScrollArea.scrollHeight;
          },
          onCitations: (citations) => {
            gatheredCitations = citations;
          },
          onVerification: (verification) => {
            reportedVerification = verification;
            if (verification.withheldCount && verification.withheldCount > 0) {
              addTimelineStage(timelineEl, 'Grounding Gate Screening', `Withheld ${verification.withheldCount} unsupported unit(s)`);
            }
          },
          onClarification: (clarification) => {
            addTimelineStage(timelineEl, 'Clarification Requested (ask_user)', clarification.question);
            const clarBox = document.createElement('div');
            clarBox.style.marginTop = '12px';
            clarBox.style.padding = '12px 14px';
            clarBox.style.background = 'var(--bg-app)';
            clarBox.style.border = '1px solid var(--border-medium)';
            clarBox.style.borderRadius = 'var(--radius-sm)';
            clarBox.innerHTML = `
              <div style="font-weight:600; font-size:13px; color:var(--brand-cyan); margin-bottom:6px;">Clarification Needed:</div>
              <div style="font-size:13px; margin-bottom:8px;">${escapeHtml(clarification.question)}</div>
              ${clarification.options && clarification.options.length > 0 ? `
                <div style="display:flex; flex-wrap:wrap; gap:6px;">
                  ${clarification.options.map(opt => `<button type="button" class="btn-secondary" style="font-size:11px; padding:4px 10px;" onclick="window.populateComposerPrompt('${escapeHtml(opt)}')">${escapeHtml(opt)}</button>`).join('')}
                </div>
              ` : ''}
            `;
            assistantRow.appendChild(clarBox);
          },
          onDone: (done, finalUnits) => {
            reportedDone = done;
            if (finalUnits.length > 0) {
              agentBubble.innerHTML = renderMarkdown(renderClaimUnitsMarkdown(finalUnits));
            }

            // Mark timeline completed
            const pulse = timelineEl.querySelector('.timeline-pulse-dot') as HTMLElement;
            if (pulse) {
              pulse.style.animation = 'none';
              pulse.style.backgroundColor = 'var(--agent-grounded)';
              pulse.style.boxShadow = 'none';
            }
            const meta = timelineEl.querySelector('.timeline-header-meta');
            if (meta) {
              meta.textContent = `Completed (${done.outcome}) in ${done.attemptsUsed || 1} attempt(s)`;
            }

            // Handle outcome banners & coverage
            if (done.outcome !== 'answer') {
              assistantRow.appendChild(createOutcomeBanner(done.outcome, done.reason));
            } else {
              assistantRow.appendChild(createCoverageBanner(done.coverage, reportedVerification?.lowConfidence));
            }

            if (gatheredCitations.length > 0) {
              assistantRow.appendChild(createCitationPanel(gatheredCitations));
            }

            // Append copy action
            const actions = document.createElement('div');
            actions.className = 'message-actions';
            actions.innerHTML = `
              <button class="btn-msg-action" onclick="navigator.clipboard.writeText(this.closest('.message-row').querySelector('.message-bubble').innerText); this.innerText = 'Copied!'; setTimeout(() => this.innerText = 'Copy', 2000);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Copy</span>
              </button>
            `;
            assistantRow.appendChild(actions);

            if ((window as any).refreshSidebarConversations) {
              (window as any).refreshSidebarConversations();
            }
          },
          onError: (errMsg, code, runId) => {
            agentBubble.innerHTML = `<span style="color:var(--status-danger)">Error: ${escapeHtml(errMsg)} ${runId ? `(Run ID: ${escapeHtml(runId)})` : ''}</span>`;
          }
        });
      } catch (err: any) {
        if (err.name === 'AbortError') {
          agentBubble.innerHTML += '<br><span style="color:var(--text-muted);font-size:12px;">(Run cancelled by user)</span>';
        } else {
          agentBubble.innerHTML = `<span style="color:var(--status-danger)">Request failed: ${escapeHtml(err.message)}</span>`;
          queryInput.value = userText; // Preserve user draft
          resizeInput();
        }

        if (!hasReceivedTimelineEvents) {
          timelineEl.remove();
        }
      } finally {
        isGenerating = false;
        abortController = null;
        updateSendState();
        queryInput.focus();
      }
    }

    sendBtn.addEventListener('click', handleSendMessage);
    stopBtn.addEventListener('click', () => {
      if (abortController) {
        abortController.abort();
      }
    });

    // 7. Conversation Lifecycle
    async function loadActiveSession(sessionId: string) {
      activeSessionId = sessionId;
      localStorage.setItem('onyx_session_id', activeSessionId);

      messageColumn.innerHTML = '';
      emptyState.style.display = 'flex';
      messageColumn.appendChild(emptyState);

      try {
        const data = await getConversation(sessionId);
        if (!data || !data.messages || data.messages.length === 0) {
          return;
        }

        emptyState.style.display = 'none';
        data.messages.forEach(m => {
          const contentHtml = m.units && m.units.length > 0 
            ? renderMarkdown(renderClaimUnitsMarkdown(m.units)) 
            : renderMarkdown(m.content);
          appendMessageRow(
            m.role as any, 
            contentHtml, 
            m.citations || [], 
            m.outcome, 
            m.coverage,
            m.lowConfidence
          );
        });

        chatScrollArea.scrollTop = chatScrollArea.scrollHeight;
      } catch (err) {
        console.warn('Failed to load session messages:', err);
      }
    }

    function createNewSession() {
      if (isGenerating && abortController) abortController.abort();
      activeSessionId = 'sess_' + Math.random().toString(36).substring(2, 10);
      localStorage.setItem('onyx_session_id', activeSessionId);

      messageColumn.innerHTML = '';
      emptyState.style.display = 'flex';
      messageColumn.appendChild(emptyState);

      const headerTitle = document.getElementById('activeConvHeaderTitle');
      if (headerTitle) headerTitle.innerText = 'New Document Session';

      queryInput.value = '';
      resizeInput();
      updateSendState();
      queryInput.focus();

      if ((window as any).refreshSidebarConversations) {
        (window as any).refreshSidebarConversations();
      }
    }

    (window as any).switchChatSession = loadActiveSession;
    (window as any).startNewChat = createNewSession;

    if (headerNewBtn) headerNewBtn.addEventListener('click', createNewSession);
    if (sidebarNewBtn) sidebarNewBtn.addEventListener('click', createNewSession);

    if (headerDeleteBtn) {
      headerDeleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this conversation?')) return;
        await deleteConversation(activeSessionId);
        createNewSession();
      });
    }

    // Startup check
    loadActiveSession(activeSessionId);
    updateSendState();
  </script>
</AppLayout>
