---
// src/pages/settings.astro
// Agentic RAG Workspace Settings & Axum Backend Diagnostics
// References: Agentic RAG System Complete Design Document v11 (§0, §15, §16, §21)
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Settings — Rust Knowledge Agent v11" activeRoute="settings" pageTitle="Settings">
  <div class="page-workspace">
    <div class="page-header">
      <div class="page-title-group">
        <h1 class="page-title">Workspace Settings</h1>
        <p class="page-subtitle">Personal display modes, Axum/Tokio backend connection status, and service readiness</p>
      </div>

      <button class="btn-primary" id="btnTestConnection" style="font-size:12px; padding:6px 14px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        <span>Test Connection</span>
      </button>
    </div>

    <div class="page-body-scroll">
      <div class="page-content-container">
        <!-- Section 1: Backend Connection & Diagnostics (§15.1, §28.2) -->
        <div class="onyx-card">
          <div class="onyx-card-header">
            <div>
              <span class="onyx-card-title">Rust Backend Connection Status</span>
              <p style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">Live health & readiness probes (/health, /ready)</p>
            </div>
            <span class="status-badge warning" id="backendStatusBadge">Checking...</span>
          </div>

          <div style="display:flex; flex-direction:column; gap:10px; font-size:var(--text-xs);">
            <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-sm);">
              <span style="color:var(--text-muted);">Backend Origin:</span>
              <span style="font-family:var(--font-mono); font-weight:600;" id="backendOriginText">http://127.0.0.1:8080</span>
            </div>

            <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-sm);">
              <span style="color:var(--text-muted);">Service Framework:</span>
              <span style="font-family:var(--font-mono); font-weight:600; color:var(--brand-cyan);">Axum + Tokio (Modular Monolith, Rust 1.99.1)</span>
            </div>

            <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-sm);">
              <span style="color:var(--text-muted);">Models (v11 §0.1 D5):</span>
              <span style="font-family:var(--font-mono); font-weight:600; text-align:right;" id="modelsSpecText">nomic-embed-text-v1.5 (768-d) & Nemotron 3 Super</span>
            </div>

            <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-sm);">
              <span style="color:var(--text-muted);">Supported Formats (Release 1 §0.1 D2):</span>
              <span style="font-family:var(--font-mono); font-weight:600; color:var(--text-main);">PDF, Word (.docx), PowerPoint (.pptx)</span>
            </div>

            <div style="display:flex; justify-content:space-between; padding:10px 14px; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-sm);">
              <span style="color:var(--text-muted);">Vector Store & Security:</span>
              <span style="font-family:var(--font-mono); font-weight:600; color:var(--brand-primary);">PostgreSQL + pgvector HNSW (Live-ACL RLS)</span>
            </div>

            <div id="connectionDiagnosticMsg" style="display:none; padding:8px 12px; border-radius:var(--radius-sm); font-size:12px;"></div>
          </div>
        </div>

        <!-- Section 2: Display & Appearance Preferences -->
        <div class="onyx-card">
          <div class="onyx-card-header">
            <span class="onyx-card-title">Display & Visual Preferences</span>
          </div>

          <div style="display:flex; flex-direction:column; gap:16px;">
            <!-- Theme Selection -->
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <div>
                <div style="font-weight:600; font-size:var(--text-sm);">Workspace Theme</div>
                <div style="font-size:var(--text-xs); color:var(--text-muted);">Default dark engineering aesthetic or light technical mode</div>
              </div>
              <div style="display:flex; gap:8px;">
                <button class="btn-secondary" id="btnSetThemeDark" style="padding:6px 14px; font-size:12px;">Dark</button>
                <button class="btn-secondary" id="btnSetThemeLight" style="padding:6px 14px; font-size:12px;">Light</button>
              </div>
            </div>

            <div style="height:1px; background:var(--border-subtle);"></div>

            <!-- Geometric Canvas Particles -->
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <div>
                <div style="font-weight:600; font-size:var(--text-sm);">Ambient Geometric Network Background</div>
                <div style="font-size:var(--text-xs); color:var(--text-muted);">Subtle rotating 3D wireframe solids and particle filaments</div>
              </div>
              <label style="display:inline-flex; align-items:center; cursor:pointer;">
                <input type="checkbox" id="chkAmbientCanvas" checked style="width:18px; height:18px; accent-color:var(--brand-primary);" />
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { checkBackendHealth } from '../lib/rag/client';

    const testBtn = document.getElementById('btnTestConnection')!;
    const statusBadge = document.getElementById('backendStatusBadge')!;
    const diagMsg = document.getElementById('connectionDiagnosticMsg')!;
    const btnDark = document.getElementById('btnSetThemeDark')!;
    const btnLight = document.getElementById('btnSetThemeLight')!;
    const chkAmbient = document.getElementById('chkAmbientCanvas') as HTMLInputElement;

    async function runDiagnostics() {
      statusBadge.className = 'status-badge warning';
      statusBadge.innerText = 'Probing...';
      diagMsg.style.display = 'none';

      try {
        const health = await checkBackendHealth();
        if (health.status === 'healthy' || health.status === 'ready') {
          statusBadge.className = 'status-badge success';
          statusBadge.innerText = 'Connected & Ready';
          diagMsg.className = 'evidence-sufficiency-banner sufficient';
          diagMsg.style.display = 'block';
          diagMsg.innerHTML = `<strong>Backend Ready:</strong> Successfully connected to Rust Axum server (${health.version || 'v11'}). Models and pgvector store online.`;
        } else {
          statusBadge.className = 'status-badge warning';
          statusBadge.innerText = 'Degraded';
          diagMsg.className = 'evidence-sufficiency-banner partial';
          diagMsg.style.display = 'block';
          diagMsg.innerHTML = `<strong>Backend Degraded:</strong> The service is reachable, but one or more subcomponents reported non-ready status.`;
        }
      } catch (err: any) {
        statusBadge.className = 'status-badge danger';
        statusBadge.innerText = 'Disconnected';
        diagMsg.className = 'evidence-sufficiency-banner insufficient';
        diagMsg.style.display = 'block';
        diagMsg.innerHTML = `<strong>Connection Failed:</strong> Could not connect to upstream Rust backend at <code>http://127.0.0.1:8080</code>. Ensure the API binary is running.`;
      }
    }

    testBtn.addEventListener('click', runDiagnostics);

    // Theme toggles
    btnDark.addEventListener('click', () => {
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('onyx_theme', 'dark');
    });

    btnLight.addEventListener('click', () => {
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('onyx_theme', 'light');
    });

    // Ambient background toggle
    if (chkAmbient) {
      chkAmbient.checked = localStorage.getItem('onyx_ambient_canvas') !== 'false';
      chkAmbient.addEventListener('change', () => {
        const enabled = chkAmbient.checked;
        localStorage.setItem('onyx_ambient_canvas', String(enabled));
        const canvas = document.getElementById('ambientCanvas');
        if (canvas) {
          canvas.style.display = enabled ? 'block' : 'none';
        }
      });
    }

    // Auto-probe on initial mount
    runDiagnostics();
  </script>
</AppLayout>
