---
// src/components/chat/ChatEmptyState.astro
// Welcoming empty state tailored to evidence-driven knowledge retrieval
const promptCards = [
  {
    title: 'Summarize an uploaded policy',
    desc: 'Extract key principles and cite verifiable sections.',
    prompt: 'Summarize the uploaded policy and cite all relevant sections from the documents.'
  },
  {
    title: 'Compare two document versions',
    desc: 'Identify changes, exceptions, and version differences.',
    prompt: 'Compare the policy requirements between the document versions, highlighting any exceptions or rule changes.'
  },
  {
    title: 'Find a specific requirement',
    desc: 'Retrieve exact conditions, constraints, and clauses.',
    prompt: 'Find the specific requirements and constraints regarding technical compliance in the approved documents.'
  },
  {
    title: 'Extract key facts from a document',
    desc: 'Structure documented facts with traceable evidence.',
    prompt: 'Extract all documented specifications and verification rules into a structured, cited summary.'
  }
];
---

<div class="chat-empty-state" id="chatEmptyState">
  <div class="empty-state-badge">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
  </div>
  <h1 class="empty-state-title">Ask your documents. Examine the evidence.</h1>
  <p class="empty-state-desc">
    Get answers from approved internal documents, inspect the supporting sources, and see when more information is needed.
  </p>

  <div class="empty-prompt-grid">
    {promptCards.map(p => (
      <button 
        type="button" 
        class="empty-prompt-card" 
        data-prompt={p.prompt}
        onclick="window.populateComposerPrompt(this.getAttribute('data-prompt'))"
      >
        <span class="empty-prompt-title">{p.title}</span>
        <span class="empty-prompt-desc">{p.desc}</span>
      </button>
    ))}
  </div>
</div>
